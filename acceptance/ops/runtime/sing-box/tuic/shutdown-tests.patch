diff --git a/tuic/shutdown_test.go b/tuic/shutdown_test.go
new file mode 100644
--- /dev/null
+++ b/tuic/shutdown_test.go
@@ -0,0 +1,55 @@
+package tuic
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/sagernet/quic-go"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestServerShutdown(t *testing.T) {
+	for _, early := range []bool{false, true} {
+		for _, cancelFirst := range []bool{false, true} {
+			t.Run(fmt.Sprintf("early=%v/cancel=%v", early, cancelFirst), func(t *testing.T) {
+				fixture := newShutdownFixture(t, early)
+				var peers []context.Context
+				for range 3 {
+					peers = append(peers, fixture.connectedPeer(t, early))
+				}
+				if cancelFirst {
+					fixture.cancel()
+				}
+				closeShutdownService(t, fixture.service)
+				requireShutdown(t, fixture.socket.Close())
+				for _, peer := range peers {
+					select {
+					case <-peer.Done():
+						var appErr *quic.ApplicationError
+						if !errors.As(context.Cause(peer), &appErr) || !appErr.Remote || appErr.ErrorCode != 0 {
+							t.Fatalf("peer closed without the server application close: %v", context.Cause(peer))
+						}
+					case <-time.After(time.Second):
+						t.Fatal("peer did not receive QUIC CONNECTION_CLOSE before UDP socket closed")
+					}
+				}
+			})
+		}
+	}
+}
+
+func closeShutdownService(t *testing.T, service *Service[string]) {
+	t.Helper()
+	errors := make(chan error, 8)
+	var pending sync.WaitGroup
+	for range cap(errors) {
+		pending.Go(func() { errors <- service.Close() })
+	}
+	pending.Wait()
+	close(errors)
+	for err := range errors {
+		requireShutdown(t, err)
+	}
+}
diff --git a/tuic/shutdown_fixture_test.go b/tuic/shutdown_fixture_test.go
new file mode 100644
--- /dev/null
+++ b/tuic/shutdown_fixture_test.go
@@ -0,0 +1,142 @@
+package tuic
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"io"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	aTLS "github.com/sagernet/sing/common/tls"
+)
+
+type shutdownTLS struct {
+	config  *tls.Config
+	timeout time.Duration
+}
+
+func shutdownCertificate(t *testing.T) (*shutdownTLS, *shutdownTLS) {
+	t.Helper()
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	requireShutdown(t, err)
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1), DNSNames: []string{"shutdown.test"},
+		NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		KeyUsage:    x509.KeyUsageDigitalSignature,
+		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, public, private)
+	requireShutdown(t, err)
+	cert, err := x509.ParseCertificate(der)
+	requireShutdown(t, err)
+	trust := x509.NewCertPool()
+	trust.AddCert(cert)
+	server := &tls.Config{
+		Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: private}},
+		NextProtos:   []string{"tuic"}, MinVersion: tls.VersionTLS13,
+	}
+	client := &tls.Config{
+		RootCAs: trust, ServerName: "shutdown.test", NextProtos: []string{"tuic"},
+		MinVersion: tls.VersionTLS13,
+	}
+	return &shutdownTLS{config: server}, &shutdownTLS{config: client}
+}
+
+func (c *shutdownTLS) ServerName() string                        { return c.config.ServerName }
+func (c *shutdownTLS) SetServerName(name string)                 { c.config.ServerName = name }
+func (c *shutdownTLS) NextProtos() []string                      { return c.config.NextProtos }
+func (c *shutdownTLS) SetNextProtos(protocols []string)          { c.config.NextProtos = protocols }
+func (c *shutdownTLS) HandshakeTimeout() time.Duration           { return c.timeout }
+func (c *shutdownTLS) SetHandshakeTimeout(timeout time.Duration) { c.timeout = timeout }
+func (c *shutdownTLS) STDConfig() (*tls.Config, error)           { return c.config, nil }
+func (c *shutdownTLS) Clone() aTLS.Config {
+	return &shutdownTLS{config: c.config.Clone(), timeout: c.timeout}
+}
+func (c *shutdownTLS) Start() error { return nil }
+func (c *shutdownTLS) Close() error { return nil }
+func (c *shutdownTLS) Client(conn net.Conn) (aTLS.Conn, error) {
+	return tls.Client(conn, c.config), nil
+}
+func (c *shutdownTLS) Server(conn net.Conn) (aTLS.Conn, error) {
+	return tls.Server(conn, c.config), nil
+}
+
+type shutdownFixture struct {
+	service   *Service[string]
+	socket    net.PacketConn
+	cancel    context.CancelFunc
+	clientTLS *shutdownTLS
+}
+
+func newShutdownFixture(t *testing.T, early bool) *shutdownFixture {
+	t.Helper()
+	serverTLS, clientTLS := shutdownCertificate(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	service, err := NewService[string](ServiceOptions{
+		Context: ctx, Logger: logger.NOP(), TLSConfig: serverTLS,
+		ZeroRTTHandshake: early, Handler: shutdownEcho{},
+	})
+	requireShutdown(t, err)
+	service.UpdateUsers([]string{"peer"}, [][16]byte{{}}, []string{"test-only"})
+	socket, err := net.ListenPacket("udp", "127.0.0.1:0")
+	requireShutdown(t, err)
+	t.Cleanup(func() { _ = socket.Close() })
+	requireShutdown(t, service.Start(socket))
+	t.Cleanup(func() { _ = service.Close() })
+	return &shutdownFixture{service: service, socket: socket, cancel: cancel, clientTLS: clientTLS}
+}
+
+func (f *shutdownFixture) connectedPeer(t *testing.T, early bool) context.Context {
+	t.Helper()
+	client, err := NewClient(ClientOptions{
+		Context: context.Background(), Dialer: N.SystemDialer,
+		ServerAddress: M.SocksaddrFromNet(f.socket.LocalAddr()),
+		TLSConfig:     f.clientTLS, Password: "test-only", ZeroRTTHandshake: early,
+	})
+	requireShutdown(t, err)
+	t.Cleanup(func() { _ = client.CloseWithError(net.ErrClosed) })
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, err := client.DialConn(ctx, M.ParseSocksaddr("127.0.0.1:12345"))
+	requireShutdown(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	requireShutdown(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err = conn.Write([]byte("authenticated"))
+	requireShutdown(t, err)
+	reply := make([]byte, len("authenticated"))
+	_, err = io.ReadFull(conn, reply)
+	requireShutdown(t, err)
+	if string(reply) != "authenticated" {
+		t.Fatalf("invalid echo: %q", reply)
+	}
+	client.connAccess.Lock()
+	defer client.connAccess.Unlock()
+	return client.conn.quicConn.Context()
+}
+
+type shutdownEcho struct{}
+
+func (shutdownEcho) NewConnectionEx(_ context.Context, conn net.Conn, _, _ M.Socksaddr, _ N.CloseHandlerFunc) {
+	defer conn.Close()
+	_, _ = io.Copy(conn, conn)
+}
+
+func (shutdownEcho) NewPacketConnectionEx(_ context.Context, conn N.PacketConn, _, _ M.Socksaddr, _ N.CloseHandlerFunc) {
+	_ = conn.Close()
+}
+
+func requireShutdown(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
